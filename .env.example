# Intended canonical origin. Set explicitly after verifying ownership and TLS.
# BLEN_SITE_URL=https://blen.ro
# Enable only after domain and content review, then rebuild for production.
# BLEN_INDEXING_ENABLED=0

# Verified provider disclosures. Leave blank while preparing legal drafts.
BLEN_PROVIDER_NAME=
BLEN_PROVIDER_REGISTRATION=
BLEN_PROVIDER_ADDRESS=
BLEN_PRIVACY_CONTACT=

# Optional local preview settings. Run npm run dev to enable preview.
# Use test identities and no customer data. Never set preview/Stripe variables on a deployment.
# FLOWELIX_CONTACT_EMAIL=maximcazacu0501@gmail.com
# FLOWELIX_DB=.flowelix/demo.sqlite

# Optional Supabase Auth for a disposable test project. PostgreSQL/Storage are not wired.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Both values are needed to switch checkout from simulation to Stripe test.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Configure independent EUR and RON minor-unit amounts for each Stripe test offering.
FLOWELIX_PRICE_CLEANUP_EUR=
FLOWELIX_PRICE_CLEANUP_RON=
FLOWELIX_PRICE_FORMATTING_EUR=
FLOWELIX_PRICE_FORMATTING_RON=
FLOWELIX_PRICE_REPORTING_EUR=
FLOWELIX_PRICE_REPORTING_RON=
FLOWELIX_PRICE_BUILDER_EUR=
FLOWELIX_PRICE_BUILDER_RON=
